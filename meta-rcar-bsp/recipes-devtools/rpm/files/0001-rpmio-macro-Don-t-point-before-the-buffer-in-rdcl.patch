From: Thinh Le <thinh.le.yn@renesas.com>
Subject: [PATCH] rpmio/macro: Don't point before the buffer in rdcl()

rdcl() starts with "q = buf - 1". With -D_FORTIFY_SOURCE=3 (the default
of gcc 13 on Ubuntu 24.04) gcc computes a dynamic object size of 0 for
that pointer, so the first read becomes __fgets_chk(q, 0, ...), which
reads nothing and returns NULL. Every macro file then looks empty, no
error is printed, and rpmdeps fails with "No file attributes configured".

Keep q one past the last kept character instead. The line-joining logic
is unchanged.

Upstream-Status: Backport [https://github.com/rpm-software-management/rpm/commit/75275a87cff04da65d3557f2c40ea2b526528c4c, pointer handling only]
Signed-off-by: Thinh Le <thinh.le.yn@renesas.com>
---
--- a/rpmio/macro.c
+++ b/rpmio/macro.c
@@ -197,7 +197,7 @@
 static char *
 rdcl(char * buf, size_t size, FILE *f)
 {
-    char *q = buf - 1;		/* initialize just before buffer. */
+    char *q = buf;		/* one past the last kept char */
     size_t nb = 0;
     size_t nread = 0;
     int pc = 0, bc = 0;
@@ -205,14 +205,14 @@
 
     if (f != NULL)
     do {
-	*(++q) = '\0';			/* terminate and move forward. */
+	*q = '\0';			/* terminate */
 	if (fgets(q, size, f) == NULL)	/* read next line. */
 	    break;
 	nb = strlen(q);
 	nread += nb;			/* trim trailing \r and \n */
-	for (q += nb - 1; nb > 0 && iseol(*q); q--)
+	for (q += nb; nb > 0 && iseol(q[-1]); q--)
 	    nb--;
-	for (; p <= q; p++) {
+	for (; p < q; p++) {
 	    switch (*p) {
 		case '\\':
 		    switch (*(p+1)) {
@@ -233,14 +233,14 @@
 		case ')': if (pc > 0) pc--; break;
 	    }
 	}
-	if (nb == 0 || (*q != '\\' && !bc && !pc) || *(q+1) == '\0') {
-	    *(++q) = '\0';		/* trim trailing \r, \n */
+	if (nb == 0 || (q[-1] != '\\' && !bc && !pc) || *q == '\0') {
+	    *q = '\0';		/* trim trailing \r, \n */
 	    break;
 	}
 	q++; nb++;			/* copy newline too */
 	size -= nb;
-	if (*q == '\r')			/* XXX avoid \r madness */
-	    *q = '\n';
+	if (q[-1] == '\r')		/* XXX avoid \r madness */
+	    q[-1] = '\n';
     } while (size > 0);
     return (nread > 0 ? buf : NULL);
 }
